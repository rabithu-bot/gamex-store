// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  price           Int
  originalPrice   Int? // optional "was" price, shown struck through next to price when higher
  category        String
  // Public in-game UID shown to buyers on the storefront card (e.g. a Free
  // Fire UID) — purely informational, distinct from accountId/accountPassword
  // below which stay private until purchase. Optional since existing listings
  // predate this field.
  gameUid         String?
  // Small badge shown next to category on the product page, e.g. "Premium" /
  // "Standard" — free text set by the admin per listing, optional.
  tier            String?
  level           Int?
  server          String?
  // JSON array of short tag strings, e.g. ["3 EVO MAX", "PRIME 7"] — shown as
  // pills in the "Rare Items Included" section. Defaults to an empty array
  // rather than null so display code never needs a null-check before parsing.
  rareItems       String   @default("[]")
  images          String // JSON array of file paths
  status          String   @default("available") // available | sold
  accountId       String
  accountPassword String
  createdAt       DateTime @default(now())
  orders          Order[]
}

model Order {
  // 12-char alphabetic id ([a-zA-Z] only), generated in application code via
  // app/lib/orderIds.js — Prisma's @default() only supports built-ins
  // (autoincrement/uuid/cuid/...), so there's deliberately no @default here.
  id              String    @id
  // Nullable + SetNull: deleting a listing must never take its orders (and their
  // messages) down with it. Buyer name, title/price/credentials are snapshotted
  // onto the order at purchase time so the order stays fully readable forever,
  // independent of whatever happens to the listing afterward.
  listingId       Int?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingTitle    String
  listingPrice    Int
  accountId       String
  accountPassword String
  buyerName       String?
  screenshotPath  String?
  status          String    @default("pending") // pending | pending_verification | confirmed | declined | expired
  // Ties this order to the buyer's gamex_session_id cookie so "My Orders" can
  // find it with no login and no manually-copied order link. Nullable because
  // orders created before this field existed have none.
  sessionId       String?
  // SHA-256 hash of the buyer's single-device access token (see
  // app/lib/orderAccessToken.js) — the raw token itself is never persisted,
  // only kept in the buyer's own httpOnly cookie. Null for orders created
  // before this system existed; those are grandfathered through with no
  // ownership check rather than being locked out retroactively.
  accessTokenHash String?   @unique
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  messages        Message[]
  // Admin-set customer label shown as a colored badge in the messages list
  // and chat header, e.g. "booked" | "vip" | "priority". Free text at the
  // schema level, but the admin UI only ever offers a fixed preset.
  tag             String?
  // Updated (debounced) by the buyer's client on every keystroke in the
  // support chat input; admin's UI treats it as "stale" after a few seconds
  // to render a "Customer is typing..." indicator despite this app using
  // polling rather than a live socket connection.
  buyerTypingAt   DateTime?
  // Touched on every GET the buyer's client makes for this order (the
  // useOrderPoll hook hits this every 1.5s while any order-related page is
  // open) — lets the admin see a live "online" indicator despite this app
  // having no general-purpose buyer session/presence system.
  buyerLastSeenAt DateTime?
  // Mirror of buyerTypingAt/buyerLastSeenAt, but for the admin side — lets
  // the buyer's support chat show "Support is typing..." and an online dot
  // for the admin, matching the admin's own view of the buyer.
  adminTypingAt   DateTime?
  adminLastSeenAt DateTime?

  @@index([sessionId])
}

model Message {
  id             Int       @id @default(autoincrement())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender         String // buyer | admin
  body           String
  attachmentPath String?
  // "image" | "audio" — null for text-only messages (and for legacy image
  // attachments predating this field, which the UI falls back to treating
  // as images since that was the only attachment type before voice notes).
  attachmentType String?
  // Self-relation for swipe-to-reply/quote — the message this one is a
  // reply to. SetNull rather than Cascade so unsending the original message
  // doesn't take down every reply to it, just drops the quote.
  replyToId      Int?
  replyTo        Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReply")
  // Set when the message's non-sender has viewed the thread — lets the
  // sender's UI show a "seen" tick the way a real chat app would.
  readAt         DateTime?
  // Single emoji reaction, settable by either side — a simplification of
  // Instagram's per-person reactions (which can show one badge per person
  // in a thread); here whoever reacts most recently is what's shown.
  reaction       String?
  // Set whenever the message's own sender edits its body. Buyer edits show
  // a small "edited" label to the admin (Telegram/Instagram-style
  // transparency); admin edits are deliberately silent to the buyer, so
  // whether to surface this is a per-viewer UI decision, not something
  // this field encodes on its own.
  editedAt       DateTime?
  createdAt      DateTime  @default(now())

  @@index([orderId])
  @@index([replyToId])
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  text      String
  // Instagram-style shortcut trigger — the suggestion only shows up while
  // typing a word that matches this, not on any substring of the reply body.
  // Nullable + unique so replies saved before this field existed keep
  // working (they just never surface as a suggestion until edited).
  keyword   String?  @unique
  createdAt DateTime @default(now())
}

// Screenshots the admin uploads to build buyer trust (past deliveries,
// payment confirmations, etc.) — shown publicly on the /proofs page linked
// from the product page's "Proof" button.
model ProofImage {
  id        Int       @id @default(autoincrement())
  url       String
  // The real date this delivery/screenshot happened — distinct from
  // createdAt (upload time). Proofs are often batch-uploaded long after the
  // fact, so createdAt alone would show a misleading cluster of identical
  // dates on the public page. Nullable: legacy/undated proofs just show no
  // date rather than a fabricated or misleading one.
  proofDate DateTime?
  createdAt DateTime  @default(now())
}

// Web Push subscriptions — one row per browser/device that's granted
// notification permission. "admin" subscriptions get pinged when a tagged
// customer messages; "buyer" subscriptions are scoped to a single order and
// get pinged when the admin replies while that buyer isn't currently online.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  role      String // "admin" | "buyer"
  orderId   String? // set only for role = "buyer"
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}
