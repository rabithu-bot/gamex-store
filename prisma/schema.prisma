// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  price           Int
  originalPrice   Int? // optional "was" price, shown struck through next to price when higher
  category        String
  // Public in-game UID shown to buyers on the storefront card (e.g. a Free
  // Fire UID) — purely informational, distinct from accountId/accountPassword
  // below which stay private until purchase. Optional since existing listings
  // predate this field.
  gameUid         String?
  // Small badge shown next to category on the product page, e.g. "Premium" /
  // "Standard" — free text set by the admin per listing, optional.
  tier            String?
  level           Int?
  server          String?
  // JSON array of short tag strings, e.g. ["3 EVO MAX", "PRIME 7"] — shown as
  // pills in the "Rare Items Included" section. Defaults to an empty array
  // rather than null so display code never needs a null-check before parsing.
  rareItems       String   @default("[]")
  images          String // JSON array of file paths
  status          String   @default("available") // available | sold
  accountId       String
  accountPassword String
  createdAt       DateTime @default(now())
  orders          Order[]
}

model Order {
  // 12-char alphabetic id ([a-zA-Z] only), generated in application code via
  // app/lib/orderIds.js — Prisma's @default() only supports built-ins
  // (autoincrement/uuid/cuid/...), so there's deliberately no @default here.
  id              String    @id
  // Nullable + SetNull: deleting a listing must never take its orders (and their
  // messages) down with it. Buyer name, title/price/credentials are snapshotted
  // onto the order at purchase time so the order stays fully readable forever,
  // independent of whatever happens to the listing afterward.
  listingId       Int?
  listing         Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingTitle    String
  listingPrice    Int
  accountId       String
  accountPassword String
  buyerName       String?
  screenshotPath  String?
  status          String    @default("pending") // pending | pending_verification | confirmed | declined | expired
  // Set together whenever an admin declines a payment (see
  // app/lib/declineReasons.js for the canonical preset key list). Both are
  // cleared back to null on a fresh screenshot resubmission so a stale
  // reason never lingers past the decline it belonged to.
  declineReason   String?
  declineNote     String?
  // Ties this order to the buyer's gamex_session_id cookie so "My Orders" can
  // find it with no login and no manually-copied order link. Nullable because
  // orders created before this field existed have none.
  sessionId       String?
  // SHA-256 hash of the buyer's single-device access token (see
  // app/lib/orderAccessToken.js) — the raw token itself is never persisted,
  // only kept in the buyer's own httpOnly cookie. Null for orders created
  // before this system existed; those are grandfathered through with no
  // ownership check rather than being locked out retroactively.
  accessTokenHash String?   @unique
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  messages        Message[]

  @@index([sessionId])
}

model Message {
  id             Int      @id @default(autoincrement())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender         String // buyer | admin
  body           String
  attachmentPath String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

model QuickReply {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
