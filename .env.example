DATABASE_URL="file:./dev.db"

# Canonical production origin — used for SEO metadata (canonical URL, Open
# Graph/Twitter tags, JSON-LD) and to build absolute URLs in sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://gamexstore.com"

# Admin login (secret path — see app/mafia)
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (32+ random chars)
SESSION_SECRET="generate-a-long-random-string"

# Optional: root folder for the database + uploaded files. Leave unset for local
# dev (defaults to the project folder). On a host with a persistent disk, set this
# to the disk's mount path so data survives redeploys.
# STORAGE_DIR="/var/data"

# Web Push notifications (admin + buyer) — generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-a-vapid-keypair"
VAPID_PRIVATE_KEY="generate-a-vapid-keypair"

# UroPay (see app/api/create-uropay-order, app/api/webhooks/uropay, and
# https://www.uropay.me/documentation) — reads UPI-credit SMS via a
# companion Android app rather than a hosted checkout page. Both API_KEY and
# API_SECRET come from the API Keys section at https://app.uropay.me/ — they
# are two different values, not interchangeable. API_SECRET is what's SHA-512
# hashed to authenticate requests AND to verify the X-Uropay-Signature header
# on incoming webhooks, so it doubles as the webhook's security — there is no
# separate webhook secret to configure.
UROPAY_API_BASE_URL="https://api.uropay.me"
UROPAY_API_KEY="change-me"
UROPAY_API_SECRET="change-me"
# Checkout stays on the UPI/screenshot flow until this is set to "true" —
# only flip it once create-uropay-order/webhooks/uropay are actually
# confirmed working against UroPay's real API, or checkout breaks for buyers.
NEXT_PUBLIC_UROPAY_ENABLED="false"
