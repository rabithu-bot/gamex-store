DATABASE_URL="file:./dev.db"

# Canonical production origin — used for SEO metadata (canonical URL, Open
# Graph/Twitter tags, JSON-LD) and to build absolute URLs in sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://gamexstore.com"

# Admin login (secret path — see app/mafia)
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (32+ random chars)
SESSION_SECRET="generate-a-long-random-string"

# AWS S3 — file uploads (payment screenshots, listing photos, chat
# attachments, payment QR, proof images). Bucket needs a public-read bucket
# policy for GetObject, since objects are served via their plain
# https://<bucket>.s3.<region>.amazonaws.com/<key> URL.
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="gamexstore-media"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"

# EC2 hybrid setup — only needed on the Vercel deployment, to call heavy/
# internal API routes running on the EC2-hosted copy of this app instead of
# Vercel's serverless functions. Point at the EC2 box directly, not the
# gamexstore.com domain (Vercel owns that DNS name).
EC2_INTERNAL_URL="http://13.203.86.60:3000"
EC2_INTERNAL_SECRET="generate-a-long-random-string"

# Web Push notifications (admin + buyer) — generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-a-vapid-keypair"
VAPID_PRIVATE_KEY="generate-a-vapid-keypair"

# Gemini — used by scripts/import-instagram-listings.mjs to parse listing
# details out of post captions/photos (the script itself takes a JSON file
# of posts as input; it doesn't fetch anything from Instagram directly).
GEMINI_API_KEY="change-me"
